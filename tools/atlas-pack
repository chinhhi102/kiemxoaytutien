#!/usr/bin/env bash
# tools/atlas-pack — chuẩn hoá frame rồi ghép atlas (GAME_SPEC §12.5 B).
#
#   tools/atlas-pack            # chuẩn hoá + ghép atlas + chấm lại điểm giật
#   tools/atlas-pack --score    # chỉ chấm điểm, không sửa gì
#   tools/atlas-pack --preview  # xuất GIF + onion-skin của những anim còn đỏ
#
# Spec đặt tên công cụ này là `tools/atlas-pack`, nhưng phần việc thật nằm trong
# `server/cmd/artgen`: ở đó đã có sẵn bộ đọc/ghi PNG, bộ cắt sheet và bộ ghép atlas. Viết
# lại một bộ xử lý ảnh thứ hai chỉ để khớp đường dẫn thì vừa tốn công vừa tạo ra hai chỗ có
# thể lệch nhau. File này là lớp vỏ mỏng: tên theo spec, việc làm ở nơi có sẵn công cụ.
set -euo pipefail

cd "$(dirname "$0")/../server"

# Go không nằm trong PATH mặc định trên máy này.
GOROOT="${GOROOT:-$HOME/.cache/kx-gomod/golang.org/toolchain@v0.0.1-go1.26.0.linux-amd64}"
if [ -x "$GOROOT/bin/go" ]; then
  export GOROOT
  export GOMODCACHE="${GOMODCACHE:-$HOME/.cache/kx-gomod}"
  export PATH="$GOROOT/bin:$PATH"
fi

case "${1:-}" in
  --score)
    go run ./cmd/artgen jitter -norm
    ;;
  --preview)
    shift
    go run ./cmd/artgen preview "$@"
    ;;
  *)
    echo "== 1/3 chuẩn hoá frame (B.1–3) =="
    go run ./cmd/artgen normalize
    echo
    echo "== 2/3 ghép atlas từ frames_norm =="
    go run ./cmd/artgen prep
    echo
    echo "== 3/3 chấm lại điểm độ giật (B.5) =="
    go run ./cmd/artgen jitter -norm
    ;;
esac
